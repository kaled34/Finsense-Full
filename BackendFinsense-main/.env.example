# FinSense Backend - Environment Variables

# Server Port (Render/Railway will provide this automatically)
PORT=3001

# The URL of your deployed Frontend (used for CORS validation)
# Local development: http://localhost:3000
# Production example: https://finsense-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# MySQL Database Connection String
# Example: mysql://user:password@host:port/dbname
DATABASE_URL=mysql://root:root@localhost:3306/finsense

# Secret key for JWT Authentication (Make it long and secure for production)
JWT_SECRET=super_secret_jwt_key_12345

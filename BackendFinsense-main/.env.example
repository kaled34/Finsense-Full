# FinSense Backend - Environment Variables
# Copia este archivo como .env y rellena los valores reales antes de ejecutar el proyecto.
# NUNCA subas el archivo .env al repositorio.

# ─── Servidor ────────────────────────────────────────────────────────────────
# Puerto del servidor (Render/Railway lo provee automáticamente)
PORT=3001

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL del frontend desplegado (separar varios orígenes con coma)
# Local:       http://localhost:3000
# Producción:  https://finsense-full-seven.vercel.app
FRONTEND_URL=http://localhost:3000

# ─── Base de datos ───────────────────────────────────────────────────────────
# Cadena de conexión PostgreSQL (Prisma)
# Ejemplo local:      postgresql://postgres:tu_password@localhost:5432/finsense
# Ejemplo producción: postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/finsense

# ─── JWT ─────────────────────────────────────────────────────────────────────
# IMPORTANTE: Genera valores aleatorios largos y seguros.
# Ejemplo (Node.js):  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_LARGO_Y_ALEATORIO_DE_64_CHARS
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=REEMPLAZA_CON_OTRO_SECRETO_LARGO_Y_ALEATORIO_DISTINTO
JWT_REFRESH_EXPIRES_IN=7d

# ─── APIs externas (opcionales) ──────────────────────────────────────────────
# Abstract Email Reputation API - para validar existencia de correos en el registro
# Obtén tu clave gratuita en: https://www.abstractapi.com/email-validation-api
ABSTRACT_EMAIL_API_KEY=
